# Copy to .env.deploy and fill in (never commit .env.deploy)
# LRE ONLY — do not use BBNCS or Fly LRE credentials here

SFTP_HOST=your-host.example.com
SFTP_PORT=21
SFTP_USER=your_username
SFTP_PASSWORD=your_password
SFTP_REMOTE_DIR=/public_html

# Optional override (takes precedence over SFTP_REMOTE_DIR)
# FTP_REMOTE_DIR=/public_html
